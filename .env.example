# Copia a .env y protege el fichero:  chmod 600 .env

# Token de @BotFather
TELEGRAM_BOT_TOKEN=

# Déjalos vacíos la primera vez, arranca el broker y escribe /id en el grupo
TELEGRAM_CHAT_ID=
TELEGRAM_OWNER_IDS=

# Secreto compartido entre hooks y broker:  python3 -c "import secrets; print(secrets.token_hex(24))"
C4T_SECRET=

C4T_HOST=127.0.0.1
C4T_PORT=8799

# Prefijo de los temas, útil si varios equipos comparten grupo (cada uno con su propio bot)
# C4T_TOPIC_PREFIX=portátil ·

# Si has tecleado en el pane tmux de una sesión en los últimos N segundos, no se manda nada a Telegram
# C4T_PRESENCE_WINDOW=120

# Regex extra de comandos Bash que nunca se aprueban desde Telegram, separadas por ;;
# C4T_DANGER_EXTRA=\bkubectl\s+delete\b;;\bterraform\s+apply\b

# --- Hub de modelos local: voz, OCR y /chat (opcional) ---
# Un servicio en localhost compatible con la API de OpenAI que ofrece chat, STT, TTS y OCR.
# Si lo dejas vacío, se desactivan las notas de voz, el OCR de imágenes y /chat.
# C4T_HUB_URL=http://localhost:8081
# C4T_HUB_KEY=
# C4T_CHAT_MODEL=qwen-coder
# C4T_TTS_VOICE=ef_dora
